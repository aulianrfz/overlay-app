<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/floating_background"
    android:padding="8dp"
    android:gravity="center"
    android:elevation="12dp">

    <Button
        android:id="@+id/btnA"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_floating_a"
        android:layout_margin="4dp"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/btnB"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="B"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_floating_b"
        android:layout_margin="4dp"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/btnC"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="C"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_floating_c"
        android:layout_margin="4dp"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/btnD"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text="D"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/button_floating_d"
        android:layout_margin="4dp"
        android:elevation="0dp"
        android:stateListAnimator="@null" />

</LinearLayout>